# OneHook v2 (Ethereum mainnet) deploy settings. Copy into contracts/.env
# (gitignored) next to PRIVATE_KEY and ETHERSCAN_API_KEY, then:
#   npx hardhat run scripts/deploy-onehook.ts --network mainnet

# Immutable admin: pause, listings, metadata, fee recipient, start cap, collect.
ONEHOOK_ADMIN=0x5DdDEa56774f01fc9d207BBD7B7633596a2f4A0b
# Platform fee sink (defaults to the admin when unset).
ONEHOOK_FEE_RECIPIENT=0x5DdDEa56774f01fc9d207BBD7B7633596a2f4A0b
# The mainnet price oracle the first deployment used (IOneOracle).
ONEHOOK_ORACLE=0xd1ca49bd44a447c48d2a1fac5f35cf583d8a7b1b

# Canonical mainnet addresses (defaults in the script; listed for clarity).
POOL_MANAGER=0x000000000004444c5dc75cB358380D2e3dE08A90
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Deployer key: pays gas and holds setup rights only until RENOUNCE=1.
# Never commit it. Put it in contracts/.env or the session's environment secrets.
PRIVATE_KEY=
ETHERSCAN_API_KEY=
# Set to 1 to renounce the deployer's setup rights at the end of the script.
RENOUNCE=1
