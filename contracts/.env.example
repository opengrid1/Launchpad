# Robinhood Chain connection (fill in the official values for the environment
# you target; Robinhood Chain is an Arbitrum Orbit chain).
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=
BLOCKSCOUT_URL=
BLOCKSCOUT_API_KEY=blockscout

# Deployer
PRIVATE_KEY=

# Canonical Uniswap V3 deployment on the chain
UNISWAP_V3_FACTORY=
UNISWAP_POSITION_MANAGER=
UNISWAP_SWAP_ROUTER=
WETH_ADDRESS=

# Native/USD price with 8 decimals (e.g. 250000000000 for 2500 USD).
# Used as fallback when PRICE_FEED is not set.
ETH_USD_PRICE_8=
# Optional Chainlink-compatible aggregator for native/USD
PRICE_FEED=

# Graduation market cap in USD with 8 decimals (default 40,000 USD)
GRADUATION_CAP_USD_8=4000000000000
