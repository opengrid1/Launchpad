# Keyed Ethereum RPC (Alchemy HTTPS URL). Must allow eth_getLogs over wide ranges.
ALCHEMY_HTTP=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC
# Channel or group id (channels look like -100xxxxxxxxxx). Read it from getUpdates after posting once.
TELEGRAM_CHAT_ID=-1001234567890
# Trade alerts at or above this USD size; 0 turns trade alerts off (launches only)
MIN_TRADE_USD=0
# Seconds between polls (ms)
POLL_MS=6000
# On first start, how many blocks back to announce (0 = only new events from now)
BACKFILL_BLOCKS=0
# Where the last handled block is remembered
STATE_FILE=./state.json
# Print instead of posting
DRY_RUN=0

# --- reward keeper (optional) ---
# Gas wallet that pushes holder rewards; leave empty to run alerts only
KEEPER_PRIVATE_KEY=
# How often to push (ms), default 30 minutes
KEEPER_INTERVAL_MS=1800000
# Skip holders whose unclaimed reward is worth less than this (USD)
MIN_PUSH_USD=0.25
# Holders per transaction
BATCH=60
# Refill gas from this coin's creator fees when the wallet drops below MIN_GAS_ETH (optional)
SELF_FUND_TOKEN=
MIN_GAS_ETH=0.003
KEEPER_DRY_RUN=0
