# ---- Telegram ----
# Token from @BotFather. KEEP SECRET. Rotate with /revoke if it ever leaks.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to trade. Leave empty to lock all
# trading until you add your ID (the bot prints your ID on /start).
TELEGRAM_ALLOWED_IDS=

# ---- Wallet ----
# Private key (0x...) of the trading wallet. If empty, the bot generates one on
# first run and writes it back here. NEVER commit a real key.
PRIVATE_KEY=

# ---- Safety ----
# When true, /buy and /sell are simulated only (no transactions sent).
DRY_RUN=true

# Default slippage tolerance in basis points (500 = 5%).
SLIPPAGE_BPS=500

# ---- USD pricing ----
# Prices/market caps are shown in USD using an ETH->USD feed (CoinGecko).
# Optionally pin a fixed rate, or change the CoinGecko id if native != ETH.
ETH_USD_PRICE=
COINGECKO_ID=ethereum

# ---- Chain / DEX (Robinhood L2, chainId 4663) ----
# Defaults are baked into src/config.ts; override here only if they change.
RPC_URL=https://poptye-always-win.poptyedev.com/
