# Robinhood Chain launchpad (placeholder brand "stockpad") on Uniswap V4.
# Coins pair a creator-chosen tokenized stock (or WETH); every buy skims 1%,
# split 50/40/10 holders/creator/platform. Rewards accrue automatically in the
# coin (no harvest) and are paid in the pair stock at claim. Backend-free
# (reads straight from chain). Copy to .env.robinhood.local and build:
#   VITE_BRAND=robinhood npx vite build --mode robinhood

VITE_BRAND=robinhood
# V4 stock-pair path (RhClient, stockPair mode) against StockRhFactory.
VITE_PROTOCOL=rh-v4
VITE_LAUNCH_MODE=stock-pair
VITE_FEE_MODE=creator
VITE_REWARD_MODE=dollar

# Chain - Robinhood Chain
VITE_CHAIN_ID=4663
VITE_CHAIN_NAME="Robinhood Chain"
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com
VITE_MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11
VITE_NATIVE_SYMBOL=ETH

# stockpad V4 deployment (contracts/deployments/stockpad-v4.json).
VITE_RH_FACTORY=0xCc5Fa97158A2c13Cef69FB893d17F75e81D54Ab6
VITE_RH_HOOK=0x6207dbCF78D39DeFeA5E414c05A075273CE44044
VITE_RH_ROUTER=0x53A2cDd7ACBda7840D7064D20aE71Ab89F6951A2
VITE_RH_START_BLOCK=53107970

# Uniswap V4 singleton + StateView (Robinhood Chain), WETH + USDG for routing.
VITE_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
VITE_V4_WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
VITE_V4_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
VITE_V4_STATE_VIEW=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b

# This RPC accepts multi-million block address-scoped getLogs ranges.
VITE_LOGS_WINDOW=5000000
VITE_SCAN_SPAN=5000000

VITE_API_URL=
VITE_WS_URL=

VITE_WALLETCONNECT_PROJECT_ID=e1bda672d5deb56579fe084dddfb9174

# DexScreener does not index Robinhood Chain; leave empty.
VITE_DEXSCREENER_CHAIN=
VITE_RH_OFFICIAL=
