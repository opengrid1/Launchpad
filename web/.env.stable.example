# Steadypads — build flavor of this app for the Stable chain (stable.xyz).
# Copy to .env.local (or use as Vercel env) and fill in the contract
# addresses once the Quiver V4 stack is deployed on chain 988, then:
#   npm run build && npx vercel deploy --prod   (project: steadypads)

# Brand flavor (see src/lib/brand.ts)
VITE_BRAND=steadypads

# Chain — Stable mainnet
VITE_CHAIN_ID=988
VITE_CHAIN_NAME=Stable
VITE_RPC_URL=https://rpc.stable.xyz
VITE_EXPLORER_URL=https://stablescan.xyz
VITE_NATIVE_SYMBOL=USDT0

# v3-shim addresses required by env.ts — point at the V4 factory/WETH-equivalent
VITE_FACTORY_ADDRESS=
VITE_TOKEN_DEPLOYER_ADDRESS=
VITE_WETH_ADDRESS=

# Quiver V4 deployment on Stable (fill in after running the deploy script
# against chain 988; defaults in src/lib/client.ts are the Robinhood ones)
VITE_V4_FACTORY=
VITE_V4_HOOK=
VITE_V4_ROUTER=
VITE_V4_POOL_MANAGER=
VITE_V4_WETH=
VITE_V4_USDG=
VITE_V4_START_BLOCK=

# Backend-free mode: leave API/WS empty to read straight from the chain
VITE_API_URL=
VITE_WS_URL=

# Optional: WalletConnect Cloud project id
VITE_WALLETCONNECT_PROJECT_ID=
