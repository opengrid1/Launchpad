# stonkliquid on HyperEVM — HyperSwap V3 launchpad. Coins pair WHYPE or a
# tokenized stock; the creator earns the pool's 1% fee. Backend-free (reads
# straight from chain). Build:  VITE_BRAND=hyper … npx vite build --mode hyper

VITE_BRAND=hyper
# V3 protocol path (StableV3Client) against StableLaunchpadFactory on HyperSwap.
VITE_PROTOCOL=stable-v3
VITE_FEE_MODE=creator
VITE_REWARD_MODE=dollar

# Chain — HyperEVM (Hyperliquid L2)
VITE_CHAIN_ID=999
VITE_CHAIN_NAME=HyperEVM
VITE_RPC_URL=https://rpc.hyperliquid.xyz/evm
VITE_EXPLORER_URL=https://hyperevmscan.io
VITE_MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11
VITE_NATIVE_SYMBOL=HYPE

# HyperSwap launchpad deployment (contracts/deployments/hyperswap-launchpad.json)
VITE_FACTORY_ADDRESS=0x6F2FaEe74afec6d8798dd18652F9cF0ec9a59027
VITE_TOKEN_DEPLOYER_ADDRESS=0x073EA5E995dFA87cD13C190d2aA74aDe9cE56e0f

# HyperSwap V3 SwapRouter02 + WHYPE (18-dec wrapped native, doubles as quote).
VITE_SWAP_ROUTER=0x6d99e7f6747af2cdbb5164b6dd50e40d4fde1e77
VITE_QUOTE_ASSET=0x5555555555555555555555555555555555555555
VITE_WETH_ADDRESS=0x5555555555555555555555555555555555555555
VITE_QUOTE_DECIMALS=18
VITE_QUOTE_IS_WNATIVE=true
VITE_START_BLOCK=43964256

# HyperEVM eth_getLogs caps at a 1000-block range — keep scan spans under it.
VITE_LOGS_WINDOW=500
VITE_SCAN_SPAN=1000

VITE_API_URL=
VITE_WS_URL=

VITE_WALLETCONNECT_PROJECT_ID=e1bda672d5deb56579fe084dddfb9174
# DexScreener slug for HyperEVM (Pool explorer link falls back if unindexed).
VITE_DEXSCREENER_CHAIN=hyperliquid
