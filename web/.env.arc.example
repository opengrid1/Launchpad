# arcx.fun on Arc mainnet. Copy into the deploy environment (or a build env)
# and build:  set -a; source .env.arc.example; set +a; npm run build

VITE_BRAND=arc
VITE_PROTOCOL=stable-v3

VITE_REWARD_MODE=dollar

VITE_CHAIN_ID=5042
VITE_CHAIN_NAME=Arc
# Community proxy endpoint; swap for Circle's official RPC once published.
VITE_RPC_URL=https://real-pump-soon-trust-me-bro-again.poptyedev.com/
VITE_EXPLORER_URL=https://arc-mainnet.cloud.blockscout.com
VITE_NATIVE_SYMBOL=USDC

# StableLaunchpadFactory deployment on Arc mainnet (chain 5042)
VITE_FACTORY_ADDRESS=0xBf1010f8aF1FA8CE2F3B8441e3Ca411EEE398507
VITE_TOKEN_DEPLOYER_ADDRESS=0x72A2aFC701A9A957DEEB304025635394372df774

# Self-hosted Uniswap V3 periphery and the native-USDC ERC-20 quote
VITE_SWAP_ROUTER=0x9AAa64af3f315ab47B2f5336C5A90af11d458836
VITE_QUOTE_ASSET=0x3600000000000000000000000000000000000000
VITE_WETH_ADDRESS=0x3600000000000000000000000000000000000000

# USDC is $1.00 with 6 ERC-20 decimals; native gas is the same balance, so
# trades use the approve flow, not wrapped-native value sends.
VITE_QUOTE_DECIMALS=6
VITE_QUOTE_IS_WNATIVE=false

# The RPC prunes old history; 100k-block windows stay inside what it serves.
VITE_LOGS_WINDOW=100000
VITE_SCAN_SPAN=100000

VITE_API_URL=
VITE_WS_URL=

VITE_WALLETCONNECT_PROJECT_ID=e1bda672d5deb56579fe084dddfb9174
