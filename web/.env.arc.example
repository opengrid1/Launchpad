# arcx.fun on Arc mainnet: V4 launchpad on the official Uniswap V4 PoolManager.
# Build:  set -a; source .env.arc.example; set +a; npm run build

VITE_BRAND=arc
# V4 protocol path (default when VITE_PROTOCOL is unset)
VITE_PROTOCOL=
# Creator-fee product: fixed 1% trade fee, 80/20 creator/platform on harvest.
VITE_FEE_MODE=creator
VITE_REWARD_MODE=dollar

VITE_CHAIN_ID=5042
VITE_CHAIN_NAME=Arc
# Keyed community proxy first (full service: calls, gas), then the site's own
# /api/rpc relay (same upstream, same-origin so nothing blocks it on mobile),
# then Blockscout reads. Swap for Circle's official RPC once published.
VITE_RPC_URL=https://real-pump-soon-trust-me-bro-again.poptyedev.com/b71fac7173778c3f6a9148c157b8b4f61d275b447b087327,/api/rpc,https://arc-mainnet.cloud.blockscout.com/api/eth-rpc
VITE_EXPLORER_URL=https://arc-mainnet.cloud.blockscout.com
VITE_MULTICALL3=0xC5B8D4975a7976F6DCe98B7Cb6Ec91b5D59E8C1e
VITE_NATIVE_SYMBOL=USDC

# V4 launchpad deployment (Arc chain 5042, official PoolManager)
VITE_V4_FACTORY=0x3004664a07bDA6CbD416C9486Dc1212eE81fA1fC
VITE_V4_HOOK=0xfE1e80495C412cF3f4C0dE305C9Ca1570bbA8044
VITE_V4_ROUTER=0x6dE8C12324Cd13E40E813B390F8Eea38DBA299b0
VITE_V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
VITE_V4_STATE_VIEW=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b
VITE_V4_WETH=0xD79aB912c0c5cdDa7FAC89C75deB6ae84028e82e
VITE_V4_USDG=0xD79aB912c0c5cdDa7FAC89C75deB6ae84028e82e
VITE_V4_START_BLOCK=12955261
VITE_START_BLOCK=12955261

# Legacy env slots read by lib/env.ts
VITE_FACTORY_ADDRESS=0x3004664a07bDA6CbD416C9486Dc1212eE81fA1fC
VITE_TOKEN_DEPLOYER_ADDRESS=0x3004664a07bDA6CbD416C9486Dc1212eE81fA1fC
